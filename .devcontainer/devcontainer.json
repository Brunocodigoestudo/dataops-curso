{
  "name": "dataops-curso",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  // Roda uma vez, quando o codespace é criado: instala as dependências do projeto
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Vale para todo terminal aberto: o dbt usa o profiles.yml da raiz do projeto
  "remoteEnv": {
    "DBT_PROFILES_DIR": "${containerWorkspaceFolder}"
  },

  // Porta do dbt docs serve
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "dbt docs" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
